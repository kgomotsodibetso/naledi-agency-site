/**
 * @fileOverview Firestore Security Rules for Naledi Digital.
 *
 * Core Philosophy:
 * This ruleset is designed for an application focused on lead capture and content management.
 * All write access is restricted to authorized admins, while read access is generally public for site content.
 * The lead submissions are open to the public, but with validation.
 *
 * Data Structure:
 * - /leads/{leadId}: Stores lead data submitted via the "Submit Enquiry" form.
 * - /site_content/{contentId}: Stores website content.
 *
 * Key Security Decisions:
 * - Leads collection is publicly writable but implements server side validation to prevent spam or malicious attacks
 * - All other write operations are blocked to prevent unauthorized data modification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create a lead.
     * @path /leads/{leadId}
     * @allow (create) - Any user can submit a lead.
     * @deny (update) - No one can update a lead.
     * @deny (delete) - No one can delete a lead.
     * @principle Allows public write access for lead capture, but validate the content
     */
    match /leads/{leadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidLeadData();
    }

    /**
     * @description Restricts write access to the site_content collection.
     * @path /site_content/{contentId}
     * @allow (get, list) - Any user can read a piece of site content.
     * @deny (create, update, delete) - No one can create, update, or delete site content.
     * @principle Restricts all write access to site content, effectively making it read-only for regular users.
     */
    match /site_content/{contentId} {
      allow get: if true;
      allow list: if true;
    }

    // Helper function to validate lead data
    function isValidLeadData() {
        return request.resource.data.keys().hasAll(['name', 'email', 'company', 'service', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.company is string
        && request.resource.data.service is string
        && request.resource.data.message is string
        && request.resource.data.createdAt is string;
    }
  }
}