/**
 * @file Firestore Security Rules for Naledi Digital.
 *
 * @core_philosophy This ruleset enforces a public read policy for site content and restricts write access to the leads collection and the site_content collection.
 *
 * @data_structure
 * - `/leads/{leadId}`: Stores potential customer leads.
 * - `/site_content/{contentId}`: Stores website content.
 *
 * @key_security_decisions
 * - Leads are publicly writable but this is limited to creation. Only authenticated users can edit the leads.
 * - Site content is only editable by authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls read and write access to the /leads collection.
     * @path /leads/{leadId}
     * @allow (create) - Any user can create a new lead.
     * @deny (update) - No one can update a lead.
     * @deny (delete) - No one can delete a lead.
     * @allow (get, list) - Any user can read lead data.
     * @principle Allows public read and create access, but restricts modifications.
     */
    match /leads/{leadId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Controls read and write access to the /site_content collection.
     * @path /site_content/{contentId}
     * @allow (get, list) - Any user can read site content.
     * @deny (create, update, delete) - Only authenticated users can create, update, or delete content.
     * @principle Restricts write access to site content to authenticated users.
     */
    match /site_content/{contentId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}