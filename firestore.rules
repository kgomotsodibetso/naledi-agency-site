/**
 * @fileoverview Firestore Security Rules for Naledi Digital.
 *
 * Core Philosophy:
 * This ruleset implements a basic content management and lead capture security model.
 * The primary goal is to allow public read access to certain collections while restricting write access to prevent unauthorized modifications.
 * There are two top level collections that are publicly writable: `/leads` and `/newsletter_subscribers`.
 * In this prototype phase, validation is relaxed to enable rapid iteration, but authorization is strictly enforced.
 *
 * Data Structure:
 * - /leads/{leadId}: Stores potential customer leads.
 * - /site_content/{contentId}: Stores website content.
 * - /newsletter_subscribers/{subscriberId}: Stores newsletter subscribers.
 *
 * Key Security Decisions:
 * - Public read access is granted where appropriate for website content.
 * - Write access is restricted to prevent unauthorized data manipulation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the /leads collection, allowing anyone to create a lead.
     * @path /leads/{leadId}
     * @allow (create) - Any unauthenticated user can submit a lead.
     * @deny (update, delete) - No one can update or delete a lead after submission.
     * @principle Allows public lead submission while preventing unauthorized modifications.
     */
    match /leads/{leadId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures the /site_content collection, restricting all access for now.
     * @path /site_content/{contentId}
     * @allow - None
     * @deny (create, update, delete, get, list) - No access is allowed.
     * @principle Restricts all access for site content, needs to be reviewed
     */
    match /site_content/{contentId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures the /newsletter_subscribers collection, allowing anyone to subscribe to the newsletter.
     * @path /newsletter_subscribers/{subscriberId}
     * @allow (create) - Any unauthenticated user can subscribe to the newsletter.
     * @deny (update, delete) - No one can update or delete a subscriber after submission.
     * @principle Allows public newsletter subscription while preventing unauthorized modifications.
     */
    match /newsletter_subscribers/{subscriberId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}